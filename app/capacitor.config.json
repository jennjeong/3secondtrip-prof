{
  "appId": "com.threesecondtrip.app",
  "appName": "3초 여행",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#020A1E"
  },
  "android": {
    "backgroundColor": "#020A1E"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 3000,
      "launchAutoHide": false,
      "backgroundColor": "#020A1E",
      "showSpinner": false,
      "launchFadeOutDuration": 200
    },
    "Keyboard": {
      "resize": "none",
      "resizeOnFullScreen": false
    }
  }
}