# ============================================================================
# 3초 여행 — Backend Configuration (.env.example)
# Copy to .env and fill in real values for local development.
#
# IMPORTANT: this file holds *configuration and secrets only*.
# User information (profile, schedules, reviews, blogs, etc.) is stored in
# SQLite, NOT here.  Never commit .env.
# ============================================================================

APP_ENV=local
APP_HOST=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5500

# SQLite — relative path resolved from the backend working dir
DATABASE_URL=sqlite:///./data/travel_app.sqlite3

# JWT (HS256)
JWT_SECRET=replace_with_long_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# OAuth — Kakao
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/auth/kakao/callback

# OAuth — Naver
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:8000/auth/naver/callback

# OAuth — Apple
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=./secrets/AuthKey_XXXXXXXXXX.p8
APPLE_REDIRECT_URI=http://localhost:8000/auth/apple/callback

# OpenAI (server-side proxy only — never expose to frontend)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# HTTPS (set to true for local SSL via run_https.py)
HTTPS_ENABLED=false
SSL_CERT_FILE=
SSL_KEY_FILE=

# ── Google Maps Platform ──────────────────────────────────────────────
# Server key — backend only, IP/server-restricted at GCP Console.
# Used for Routes API v2 + Places API v1 server-side calls.
GOOGLE_MAPS_SERVER_KEY=your_google_maps_server_key_here
# Browser key — referrer-restricted at GCP Console.  Served to frontend
# via /api/config/maps so it can load maps.googleapis.com/maps/api/js.
GOOGLE_MAPS_BROWSER_KEY=your_google_maps_browser_key_here

# Fernet key for encrypting user PII columns at rest (name / phone / birth_date).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DB_ENCRYPTION_KEY=your_fernet_key_here
